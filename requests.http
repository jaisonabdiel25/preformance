### API de autenticacion - peticiones de prueba
#
# Requiere la extension "REST Client" de VS Code (humao.rest-client).
# Pulsa "Send Request" sobre cada bloque. Las variables @accessToken y
# @refreshToken se rellenan solas a partir de la respuesta del login.

@host = http://localhost:3000
@baseUrl = {{host}}/api/v1

@email = ana.torres@example.com
@password = Secreta123

###############################################################################
# 1. Salud del servicio (comprueba tambien la conexion a PostgreSQL)
###############################################################################

GET {{host}}/health

###############################################################################
# 1b. Catalogo de paises (publico, para poblar un desplegable en el registro)
###############################################################################

GET {{baseUrl}}/countries

###############################################################################
# 2. Registro - camino feliz -> 201
#    birthDate y countryCode son OPCIONALES; role NO se acepta (lo pone el
#    servidor con USER).
###############################################################################

# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Ana Torres",
  "birthDate": "1990-05-14",
  "countryCode": "PA"
}

###############################################################################
# 2b. Registro minimo, sin los campos opcionales -> 201 con birthDate y
#     country a null
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "minimo@example.com",
  "password": "{{password}}",
  "name": "Sin Datos"
}

###############################################################################
# 2c. SEGURIDAD: intentar autoasignarse el rol -> 422 (lo corta strictObject)
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "intruso-rol@example.com",
  "password": "{{password}}",
  "name": "Intruso",
  "role": "ADMIN"
}

###############################################################################
# 2d. Menor de 18 -> 422
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "menor@example.com",
  "password": "{{password}}",
  "name": "Menor Edad",
  "birthDate": "2015-01-01"
}

###############################################################################
# 2e. Pais que no esta en el catalogo -> 422 sobre countryCode
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "pais-falso@example.com",
  "password": "{{password}}",
  "name": "Pais Falso",
  "countryCode": "XX"
}

###############################################################################
# 3. Registro duplicado -> 409 CONFLICT
#    (ejecuta el bloque anterior dos veces)
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Ana Torres"
}

###############################################################################
# 4. Validacion: contrasena debil -> 422 con detalle por campo
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "debil@example.com",
  "password": "123",
  "name": "X"
}

###############################################################################
# 5. Validacion: email invalido -> 422
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "esto-no-es-un-email",
  "password": "Secreta123",
  "name": "Prueba"
}

###############################################################################
# 6. Validacion: campo no declarado -> 422 (lo rechaza strictObject)
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "intruso@example.com",
  "password": "Secreta123",
  "name": "Intruso",
  "role": "admin"
}

###############################################################################
# 7. Login correcto -> 200. Guarda los tokens para los bloques siguientes.
###############################################################################

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

@accessToken = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}

###############################################################################
# 8. Login con contrasena incorrecta -> 401 (mensaje generico)
###############################################################################

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "PasswordIncorrecta1"
}

###############################################################################
# 9. Login con email inexistente -> 401 con el MISMO mensaje que el bloque 8
###############################################################################

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "no-existe@example.com",
  "password": "PasswordIncorrecta1"
}

###############################################################################
# 10. Perfil con token valido -> 200
###############################################################################

GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

###############################################################################
# 11. Perfil sin cabecera Authorization -> 401
###############################################################################

GET {{baseUrl}}/auth/me

###############################################################################
# 12. Perfil con token manipulado -> 401
###############################################################################

GET {{baseUrl}}/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmYWxzbyJ9.firma-invalida

###############################################################################
# 13. Rotacion: canjear el refresh token -> 200 con un par nuevo
###############################################################################

# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

@rotatedRefreshToken = {{refresh.response.body.refreshToken}}

###############################################################################
# 14. Reusar el refresh token YA canjeado -> 401
#     (vuelve a lanzar el bloque 13 sin haber hecho login de nuevo)
###############################################################################

POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###############################################################################
# 15. Logout con el refresh token rotado -> 204
###############################################################################

POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

###############################################################################
# 16. Usar el refresh token tras el logout -> 401
###############################################################################

POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

###############################################################################
# 17. Ruta inexistente -> 404 en formato JSON
###############################################################################

GET {{baseUrl}}/no-existe

###############################################################################
# 18. JSON malformado -> 400 INVALID_JSON
###############################################################################

POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "roto@example.com",

###############################################################################
# 19. TAREAS - crear -> 201. Guarda el id para los bloques siguientes.
#     Requiere haber ejecutado el bloque 7 (login) para tener @accessToken.
###############################################################################

# @name createTodo
POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "Comprar pan",
  "description": "Integral, de la panaderia de la esquina"
}

@todoId = {{createTodo.response.body.todo.id}}

###############################################################################
# 19b. Crear sin token -> 401
###############################################################################

POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Tarea anonima"
}

###############################################################################
# 19c. SEGURIDAD: crear una tarea a nombre de otro -> 422
#      `userId` no esta en createTodoSchema y strictObject lo rechaza.
###############################################################################

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "Tarea inyectada",
  "userId": "00000000-0000-4000-8000-000000000000"
}

###############################################################################
# 19d. Titulo vacio al crear -> 422 "El titulo es obligatorio"
###############################################################################

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": ""
}

###############################################################################
# 19e. Titulo de solo espacios al crear -> 422 tambien.
#      El .trim() corre ANTES del .min(1), asi que "   " queda en "" y falla.
###############################################################################

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "   "
}

###############################################################################
# 20. Listar MIS tareas -> 200. Nunca aparecen las de otro usuario:
#     el userId sale del token, no de la URL.
###############################################################################

GET {{baseUrl}}/todos
Authorization: Bearer {{accessToken}}

###############################################################################
# 21. Actualizar parcialmente -> 200 (PATCH: basta con el campo que cambia)
###############################################################################

PATCH {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "completed": true
}

###############################################################################
# 21b. Cuerpo vacio -> 422 (el .refine() exige al menos un campo)
###############################################################################

PATCH {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

###############################################################################
# 21e. Titulo vacio al actualizar -> 422 "El titulo NO PUEDE ESTAR VACIO".
#      Mensaje distinto al de crear a proposito: en PATCH el titulo es opcional,
#      asi que "es obligatorio" seria falso. Mandarlo vacio si es un error.
###############################################################################

PATCH {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "   "
}

###############################################################################
# 21c. Id que no es un UUID -> 422, no 500
###############################################################################

PATCH {{baseUrl}}/todos/abc
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "completed": true
}

###############################################################################
# 21d. Tarea inexistente -> 404
###############################################################################

PATCH {{baseUrl}}/todos/00000000-0000-4000-8000-000000000000
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "completed": true
}

###############################################################################
# 22. Eliminar -> 204 sin cuerpo
###############################################################################

DELETE {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{accessToken}}

###############################################################################
# 22b. Eliminar la misma tarea otra vez -> 404
###############################################################################

DELETE {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{accessToken}}

###############################################################################
# 23. PROPIEDAD: un segundo usuario NO puede tocar las tareas del primero.
#     Ejecuta 23a y 23b, y luego 23c/23d con un @todoId del PRIMER usuario
#     (vuelve a crear uno con el bloque 19 antes de probar).
#     Ambos deben responder 404, no 403: no se confirma que el id exista.
###############################################################################

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "intrusa@example.com",
  "password": "Secreta123",
  "name": "Intrusa"
}

###############################################################################
# 23b. Login del segundo usuario
###############################################################################

# @name loginIntrusa
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "intrusa@example.com",
  "password": "Secreta123"
}

@intrusaToken = {{loginIntrusa.response.body.accessToken}}

###############################################################################
# 23c. La intrusa lista SUS tareas -> 200, sin rastro de las del primer usuario
###############################################################################

GET {{baseUrl}}/todos
Authorization: Bearer {{intrusaToken}}

###############################################################################
# 23d. La intrusa intenta modificar una tarea ajena -> 404
###############################################################################

PATCH {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{intrusaToken}}

{
  "title": "Secuestrada"
}

###############################################################################
# 23e. La intrusa intenta borrar una tarea ajena -> 404
###############################################################################

DELETE {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{intrusaToken}}
