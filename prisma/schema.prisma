// Fuente unica de verdad del esquema de datos.
//
// De este archivo salen tres cosas:
//   - las migraciones SQL   -> npm run migrate:dev
//   - el cliente tipado     -> npm run generate  (a src/generated/prisma)
//   - los tipos de fila     -> User / RefreshToken, reexportados en types/user.types.ts
//
// La URL de conexion NO va aqui: en Prisma 7 la lee `prisma.config.ts` desde el entorno.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // dbgenerated en vez de uuid(): el UUID lo pone PostgreSQL con gen_random_uuid(),
  // no el cliente, de modo que un INSERT hecho por fuera de Prisma tambien lo obtiene.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // AuthService normaliza el email a minusculas antes de llegar al repositorio,
  // asi que una unicidad exacta basta para impedir cuentas duplicadas.
  email        String @unique(map: "users_email_key") @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  name         String @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // @updatedAt lo gestiona Prisma en el cliente. Sustituye al trigger set_updated_at
  // que habia antes en la BD: una escritura por fuera de Prisma ya no lo actualiza.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // SHA-256 en hexadecimal (64 caracteres) del token opaco. El valor en claro solo
  // existe en la respuesta HTTP: quien lea esta tabla no puede reconstruir ningun
  // token utilizable.
  tokenHash String @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(64)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  // NULL mientras el token sigue vivo. Lo rellenan la rotacion (/refresh) y /logout.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}
