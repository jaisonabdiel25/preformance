// Fuente unica de verdad del esquema de datos.
//
// De este archivo salen tres cosas:
//   - las migraciones SQL   -> npm run migrate:dev
//   - el cliente tipado     -> npm run generate  (a src/generated/prisma)
//   - los tipos de fila     -> User / RefreshToken, reexportados en types/user.types.ts
//
// La URL de conexion NO va aqui: en Prisma 7 la lee `prisma.config.ts` desde el entorno.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Catalogo de roles.
///
/// Es una tabla y no un enum para poder anadir roles sin migracion y describirlos
/// desde la BD. El precio es que `roleCode` es un `string` para TypeScript: por eso
/// las comparaciones en codigo deben usar el objeto ROLE de `constants/roles.ts`,
/// y por eso el arranque verifica que los codigos que el codigo conoce existen de
/// verdad en esta tabla.
///
/// Las filas USER y ADMIN las inserta la propia migracion, no el seeder: un usuario
/// no puede existir sin rol, asi que el esquema nunca debe quedar en un estado en
/// el que registrarse sea imposible.
model Role {
  code        String  @id @db.VarChar(20)
  name        String  @db.VarChar(50)
  description String? @db.VarChar(255)

  users User[]

  @@map("roles")
}

/// Tabla de referencia de paises. Se puebla con `npm run db:seed`.
model Country {
  /// ISO 3166-1 alpha-2 como clave primaria. Es un identificador estandar y estable,
  /// asi que un usuario ya lleva el codigo encima sin necesidad de join; la union
  /// con esta tabla solo hace falta para obtener el nombre.
  code String @id @db.Char(2)
  name String @db.VarChar(100)

  users User[]

  @@map("countries")
}

model User {
  // dbgenerated en vez de uuid(): el UUID lo pone PostgreSQL con gen_random_uuid(),
  // no el cliente, de modo que un INSERT hecho por fuera de Prisma tambien lo obtiene.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // AuthService normaliza el email a minusculas antes de llegar al repositorio,
  // asi que una unicidad exacta basta para impedir cuentas duplicadas.
  email        String @unique(map: "users_email_key") @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  name         String @db.VarChar(100)

  /// El default vive en la columna escalar, no en la relacion. Es lo que impide
  /// que /register asigne rol: el DTO no lo lleva y aqui siempre sale USER.
  roleCode String @default("USER") @map("role_code") @db.VarChar(20)
  role     Role   @relation(fields: [roleCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  /// Solo la fecha, sin hora: una fecha de nacimiento no tiene zona horaria y
  /// guardarla como timestamp la desplaza un dia segun donde se lea.
  birthDate DateTime? @map("birth_date") @db.Date

  countryCode String?  @map("country_code") @db.Char(2)
  /// Restrict y no SetNull: borrar un pais que alguien esta usando debe fallar,
  /// no vaciar en silencio el dato de esos usuarios.
  country     Country? @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // @updatedAt lo gestiona Prisma en el cliente. Sustituye al trigger set_updated_at
  // que habia antes en la BD: una escritura por fuera de Prisma ya no lo actualiza.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]

  @@index([roleCode], map: "users_role_code_idx")
  @@index([countryCode], map: "users_country_code_idx")
  @@map("users")
}

model RefreshToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // SHA-256 en hexadecimal (64 caracteres) del token opaco. El valor en claro solo
  // existe en la respuesta HTTP: quien lea esta tabla no puede reconstruir ningun
  // token utilizable.
  tokenHash String @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(64)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  // NULL mientras el token sigue vivo. Lo rellenan la rotacion (/refresh) y /logout.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}
