# Copia este archivo a `.env` y ajusta los valores.
#   cp .env.example .env      (bash)
#   Copy-Item .env.example .env   (PowerShell)

NODE_ENV=development
PORT=3000

# --- PostgreSQL -------------------------------------------------------------
# Estas tres las consume el contenedor `db` de docker-compose para inicializarse.
POSTGRES_USER=preformance
POSTGRES_PASSWORD=preformance
POSTGRES_DB=preformance
# Puerto del host donde se publica el PostgreSQL del contenedor.
#
# No es 5432 a proposito. Un PostgreSQL instalado nativamente en la maquina ya ocupa
# ese puerto y se queda con las conexiones a localhost: el sintoma es un
# "password authentication failed" desde el host mientras que dentro de Docker todo
# funciona, porque el contenedor nunca llega a recibir la conexion.
#
# Si el 5441 esta cogido (por ejemplo, por la BD de otro proyecto), elige cualquier
# puerto libre y actualiza tambien DATABASE_URL. Para ver que hay ocupado:
#   docker ps --format "{{.Names}}  {{.Ports}}"
#   Get-NetTCPConnection -LocalPort 5441 -State Listen
DB_PORT=5441

# Cadena de conexion usada por la API y por node-pg-migrate.
# Apunta a localhost porque la API corre en el host: en Docker solo esta PostgreSQL,
# publicado en el puerto DB_PORT de arriba. Si cambias DB_PORT, cambialo aqui tambien.
DATABASE_URL=postgres://preformance:preformance@localhost:5441/preformance
DB_POOL_MAX=10

# --- Autenticacion ----------------------------------------------------------
# Genera un secreto propio antes de usar esto fuera de tu maquina:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=preformance-api
REFRESH_TOKEN_TTL_DAYS=7

# Coste de bcrypt. 12 es un buen equilibrio; bajalo a 10 si el login te resulta
# lento en desarrollo (cada +1 duplica el tiempo de hasheo).
BCRYPT_ROUNDS=12

# --- HTTP -------------------------------------------------------------------
# "*" permite cualquier origen. Para varios origenes, separalos por comas:
#   CORS_ORIGIN=http://localhost:5173,http://localhost:3001
CORS_ORIGIN=*

# Limite de peticiones por IP y ventana sobre /register y /login.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Cupo aparte para /refresh. Es mas alto porque lo llama cada cliente autenticado
# de forma periodica: con el limite de login, varias pestanas tras la misma IP
# publica se quedarian sin poder renovar sesion.
REFRESH_RATE_LIMIT_MAX=60
